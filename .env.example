# TTRC Store - Environment Variables Configuration (MongoDB Atlas)

# App Setup
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# MongoDB Atlas Connection & Auth Secrets
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ttrc_store?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Provider (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Payments (Optional - defaults to COD if omitted)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket Shipping (Optional)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Resend Transactional Email (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@ttrc.store
