# TTRC Store - Environment Variables Configuration (MongoDB Atlas)

# App Setup
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# MongoDB Atlas Connection & Auth Secrets
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ttrc_store?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Provider (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Payments (Optional - defaults to COD if omitted)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket Shipping (Optional)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Resend Transactional Email & OTP Verification (Server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@ttrc.store
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_WINDOW=3
EMAIL_DAILY_INTERNAL_CAP=90
EMAIL_MONTHLY_INTERNAL_CAP=2700
EMAIL_QUOTA_WARNING_THRESHOLD=0.70
